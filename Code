async function urlToData(u){
  try{
    const r=await fetch(u,{mode:'cors'});
    const b=await r.blob();
    return await new Promise((res,rej)=>{const f=new FileReader();f.onload=()=>res(f.result);f.onerror=rej;f.readAsDataURL(b)});
  }catch(e){
    return await new Promise((res,rej)=>{
      const i=new Image();i.crossOrigin='anonymous';
      i.onload=()=>{const c=document.createElement('canvas');c.width=i.naturalWidth;c.height=i.naturalHeight;c.getContext('2d').drawImage(i,0,0);try{res(c.toDataURL('image/png'))}catch(err){rej(err)}};
      i.onerror=rej;i.src=u;
    });
  }
}
function buildAIContent(text,parent,isUser,src){
  const parts=text.split(/```(?:\w+)?\n?([\s\S]*?)```/g);
  parts.forEach((seg,i)=>{
    if(i%2===1&&!isUser){
      const cb=document.createElement('div');cb.className='ai-code';
      const bar=document.createElement('div');bar.className='ai-code-bar';
      const mkBtn=(label,fn)=>{const b=document.createElement('button');b.textContent=label;b.onclick=fn;bar.appendChild(b)};
      mkBtn('Salin',()=>navigator.clipboard.writeText(seg).then(()=>toast('Kode disalin')).catch(()=>{}));
      mkBtn('Uji Sekarang',()=>launchPlayer('Pratinjau AI',URL.createObjectURL(new Blob([seg],{type:'text/html'}))));
      mkBtn('Jadi Game di Lobi',async()=>{
        const nm=(src||'Game AI').slice(0,30);
        try{await addDoc(collection(db,'games'),{name:nm,code:seg,link:'',type:'code',icon:'',uid:firebaseUser.uid,author:userDoc?.name||'Anonim',plays:0,ts:serverTimestamp()});toast('"'+nm+'" masuk ke lobi')}
        catch(e){toast('Gagal publikasi','err')}
      });
      const pre=document.createElement('pre');pre.textContent=seg;
      cb.appendChild(bar);cb.appendChild(pre);parent.appendChild(cb);
    }else if(seg.trim()){
      const c=document.createElement('div');c.className='ai-content';
      c.style.whiteSpace='pre-wrap';c.textContent=seg.trim();parent.appendChild(c);
    }
  });
}
function renderAI(){
  const b=$('#aiBody');b.textContent='';
  if(!aiHist.length&&!aiBusy){
    b.innerHTML=`<div style="margin:auto 0;padding:24px 4px;max-width:460px">
      <div style="display:inline-flex;padding:14px;background:#14271b;border:1px solid #304434;border-radius:20px;margin-bottom:14px">${robotSVG(70)}</div>
      <h3 style="font-family:var(--disp);font-weight:800;font-size:25px;margin-bottom:8px">Zing AI siap membantu</h3>
      <p style="color:var(--mut);line-height:1.7">Minta gambar untuk ikon, minta game HTML siap main (tab Kode), atau tempel kodemu di tab Agent. Ada batas waktu 1 menit — kalau gagal, pesan errornya langsung muncul, bukan muter terus.</p>
    </div>`;
    return;
  }
  aiHist.forEach(m=>{
    if(m.text.startsWith('@@IMG:')){
      const d=document.createElement('div');d.className='ai-msg bot';
      d.innerHTML='<div class="ai-role">Zing AI</div>';
      const wrap=document.createElement('div');wrap.className='ai-img-result';
      const img=new Image();img.src=m.text.slice(6);img.alt='Hasil gambar';
      const row=document.createElement('div');row.className='ai-img-row';
      const mkBtn=(label,fn)=>{const btn=document.createElement('button');btn.className='btn btn-ghost';btn.style.padding='8px 14px';btn.style.fontSize='12px';btn.textContent=label;btn.onclick=fn;row.appendChild(btn)};
      mkBtn('Jadi Ikon Game',async()=>{
        try{
          toast('Menyiapkan ikon...');
          const data=await urlToData(m.text.slice(6));
          upIconData=data;setIconPrev(data);
          openUploadModal();
          toast('Ikon siap. Isi nama lalu Publikasikan.');
        }catch(e){toast('Gagal konversi ikon. Unduh manual dulu.','err')}
      });
      mkBtn('Buka / Unduh',()=>window.open(m.text.slice(6),'_blank','noopener'));
      wrap.appendChild(img);wrap.appendChild(row);
      d.appendChild(wrap);b.appendChild(d);return;
    }
    const d=document.createElement('div');d.className='ai-msg '+(m.role==='user'?'user':'bot');
    const r=document.createElement('div');r.className='ai-role';r.textContent=m.role==='user'?'Kamu':'Zing AI';
    d.appendChild(r);
    buildAIContent(m.text,d,m.role==='user',m.src);
    b.appendChild(d);
  });
  if(aiBusy){
    const d=document.createElement('div');d.className='ai-msg bot';
    d.innerHTML=`<div class="ai-role">Zing AI</div><div class="ai-loader">${robotSVG(26)}<span>thinking (maks 1 menit)</span></div>`;
    b.appendChild(d);
  }
  b.scrollTop=b.scrollHeight;
}

