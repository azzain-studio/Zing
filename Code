async function ensureUserDoc(u){
  try{
    const d=await getDoc(doc(db,'users',u.uid));
    if(d.exists()){userDoc=d.data()}
    else{
      userDoc={name:u.displayName||pendingAnonName||'Pemain',av:''};
      await setDoc(doc(db,'users',u.uid),{...userDoc,createdAt:serverTimestamp()});
    }
    if(pendingAnonName&&u.displayName==null){
      userDoc={...(userDoc||{}),name:pendingAnonName};
      await setDoc(doc(db,'users',u.uid),{name:pendingAnonName},{merge:true});
    }
  }catch(e){userDoc={name:u.displayName||pendingAnonName||'Pemain',av:''}}
  pendingAnonName='';
}

