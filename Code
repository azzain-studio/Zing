function renderBuiltin(){
  const g=$('#gridGames');
  g.querySelectorAll('.gcard.builtin').forEach(x=>x.remove());
  Object.keys(BUILTIN_DEFAULTS).forEach(id=>{
    const d=builtinOf(id);
    const el=document.createElement('article');el.className='gcard builtin';
    el.dataset.gid=id;el.dataset.builtin='1';
    const art=document.createElement('div');art.className='gc-art';
    const img=new Image();img.src=d.icon;img.alt=d.title;art.appendChild(img);
    const info=document.createElement('div');info.className='gc-info';
    info.innerHTML='<h4></h4><p></p>';
    info.querySelector('h4').textContent=d.title;
    info.querySelector('p').textContent=d.desc;
    el.appendChild(art);el.appendChild(info);
    addActions(el,id,true);
    el.onclick=()=>openGame(id);
    g.prepend(el);
  });
  updateCount();
}
onSnapshot(doc(db,'config','builtin'),s=>{builtinData=s.data()||{};renderBuiltin()},()=>renderBuiltin());

function renderCloud(){
  const g=$('#gridGames');
  g.querySelectorAll('.gcard.cloud').forEach(x=>x.remove());
  const before=$('#cardUpload');
  cloudGames.forEach(gm=>{
    const el=document.createElement('article');el.className='gcard cloud';
    el.dataset.gid=gm.id;el.dataset.builtin='0';
    const art=document.createElement('div');art.className='gc-art';
    if(gm.icon){const i=new Image();i.src=gm.icon;art.appendChild(i)}
    else{const hue=[...(gm.name||'x')].reduce((a,c)=>(a*31+c.charCodeAt(0))%360,7);art.style.background=`linear-gradient(135deg,hsl(${hue} 45% 16%),hsl(${(hue+40)%360} 50% 22%))`;const t=document.createElement('div');t.className='gi-letter';t.textContent=(gm.name||'?')[0].toUpperCase();art.appendChild(t)}
    const info=document.createElement('div');info.className='gc-info';
    info.innerHTML='<span class="gc-tag">Komunitas</span><h4></h4><p></p>';
    info.querySelector('h4').textContent=gm.name||'Tanpa nama';
    info.querySelector('p').textContent='oleh '+(gm.author||'Anonim');
    el.appendChild(art);el.appendChild(info);
    addActions(el,gm.id,false);
    el.onclick=()=>openGame(gm.id);
    if(firebaseUser&&(isAdmin()||gm.uid===firebaseUser.uid)){
      const del=document.createElement('button');del.className='gc-del';del.title='Hapus';
      del.innerHTML='<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>';
      del.onclick=async e=>{e.stopPropagation();if(confirm('Hapus game ini?')){try{await deleteDoc(doc(db,'games',gm.id));toast('Game dihapus')}catch(err){toast('Gagal hapus','err')}}};
      const ed=document.createElement('button');ed.className='gc-del gc-edit';ed.title='Edit';
      ed.innerHTML='<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>';
      ed.onclick=e=>{e.stopPropagation();openUploadModal(gm.id)};
      el.appendChild(del);el.appendChild(ed);
    }
    g.insertBefore(el,before);
  });
  updateCount();
}
