function gameMeta(id){
  if(BUILTIN_DEFAULTS[id]){const d=builtinOf(id);return{title:d.title,url:d.url}}
  const gm=cloudGames.find(g=>g.id===id);
  return gm?{title:gm.name,url:gm.link||''}:null;
}
let myLikes=new Set(),builtinLikes={},cmtCounts={},unsubMyLikes=null;
function subMyLikes(){
  if(unsubMyLikes){unsubMyLikes();unsubMyLikes=null}
  if(!firebaseUser){myLikes=new Set();refreshLikeUI();return}
  unsubMyLikes=onSnapshot(query(collection(db,'likes'),where('uid','==',firebaseUser.uid)),s=>{
    myLikes=new Set(s.docs.map(d=>d.data().gameId));refreshLikeUI();
  },()=>{});
}
onSnapshot(doc(db,'stats','likes'),s=>{builtinLikes=s.data()||{};refreshLikeUI()},()=>{});
onSnapshot(query(collection(db,'gameComments'),orderBy('ts','desc'),limit(200)),s=>{
  cmtCounts={};s.docs.forEach(d=>{const g=d.data().gameId;cmtCounts[g]=(cmtCounts[g]||0)+1});refreshLikeUI();
},()=>{});
function refreshLikeUI(){
  $$('.gcard').forEach(el=>{
    const gid=el.dataset.gid;if(!gid)return;
    const lb=el.querySelector('.gc-act.like');
    if(lb){
      const n=el.dataset.builtin==='1'?(builtinLikes[gid]||0):(cloudGames.find(x=>x.id===gid)?.likeCount||0);
      lb.querySelector('.n').textContent=n>0?n:'';
      lb.classList.toggle('liked',myLikes.has(gid));
    }
    const cb=el.querySelector('.gc-act.cmt');
    if(cb){const c=cmtCounts[gid]||0;cb.querySelector('.n').textContent=c>0?c:''}
  });
}
async function toggleLike(gid,builtin){
  if(!firebaseUser)return openLock(()=>toggleLike(gid,builtin)),null;
  const lid=gid+'__'+firebaseUser.uid;
  try{
    const snap=await getDoc(doc(db,'likes',lid));
    if(snap.exists()){
      await deleteDoc(doc(db,'likes',lid));
      if(builtin){try{await updateDoc(doc(db,'stats','likes'),{[gid]:increment(-1)})}catch(e){await setDoc(doc(db,'stats','likes'),{[gid]:0},{merge:true})}}
      else await updateDoc(doc(db,'games',gid),{likeCount:increment(-1)}).catch(()=>{});
      myLikes.delete(gid);return false;
    }else{
      await setDoc(doc(db,'likes',lid),{gameId:gid,uid:firebaseUser.uid,ts:serverTimestamp()});
      if(builtin){try{await updateDoc(doc(db,'stats','likes'),{[gid]:increment(1)})}catch(e){await setDoc(doc(db,'stats','likes'),{[gid]:1},{merge:true})}}
      else await updateDoc(doc(db,'games',gid),{likeCount:increment(1)}).catch(()=>{});
      myLikes.add(gid);return true;
    }
  }catch(e){toast('Gagal menyukai game','err');return null}
}
async function shareGame(gid){
  const m=gameMeta(gid);if(!m)return;
  const link=location.origin+location.pathname+'?game='+encodeURIComponent(gid);
  try{
    if(navigator.share)await navigator.share({title:'Zing — '+m.title,text:'Main '+m.title+' di Zing!',url:link});
    else{await navigator.clipboard.writeText(link);toast('Link game disalin')}
  }catch(e){}
}
function addActions(el,gid,builtin){
  const info=el.querySelector('.gc-info');if(!info)return;
  const row=document.createElement('div');row.className='gc-actions';
  const like=document.createElement('button');like.type='button';like.className='gc-act like';like.title='Suka';
  like.innerHTML=heartSVG+'<span class="n"></span>';
  like.onclick=async e=>{e.stopPropagation();await toggleLike(gid,builtin);refreshLikeUI()};
  const cmt=document.createElement('button');cmt.type='button';cmt.className='gc-act cmt';cmt.title='Komentar';
  cmt.innerHTML=cmtSVG+'<span class="n"></span>';
  cmt.onclick=e=>{e.stopPropagation();openComments(gid)};
  const shr=document.createElement('button');shr.type='button';shr.className='gc-act';shr.title='Bagikan';
  shr.innerHTML=shareSVG;
  shr.onclick=e=>{e.stopPropagation();shareGame(gid)};
  row.appendChild(like);row.appendChild(cmt);row.appendChild(shr);
  info.appendChild(row);
}
let unsubCmt=null,cmtGid=null;
function openComments(gid){
  const m=gameMeta(gid);
  $('#cmtTitle').textContent='Komentar — '+(m?m.title:gid);
  cmtGid=gid;$('#cmtModal').hidden=false;$('#cmtInput').value='';
  if(unsubCmt)unsubCmt();
  const q=query(collection(db,'gameComments'),where('gameId','==',gid),limit(50));
  unsubCmt=onSnapshot(q,s=>{
    const list=$('#cmtList');list.textContent='';
    const arr=s.docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>(b.ts?.toMillis?.()||0)-(a.ts?.toMillis?.()||0));
    if(!arr.length){list.innerHTML='<p style="color:var(--mut);font-size:13px;padding:8px 0">Belum ada komentar. Jadilah yang pertama.</p>';return}
    arr.forEach(c=>{
      const row=document.createElement('div');row.className='cmt-item';
      const av=document.createElement('div');av.className='cmt-av';
      if(c.av){const i=new Image();i.src=c.av;av.appendChild(i)}else av.textContent=(c.name||'?')[0].toUpperCase();
      const body=document.createElement('div');body.className='cmt-body';
      const nm=document.createElement('div');nm.className='cmt-name';
      const n=document.createElement('span');n.textContent=c.name||'Anonim';nm.appendChild(n);
      if(firebaseUser&&c.uid===firebaseUser.uid){
        const del=document.createElement('button');del.className='cmt-del';del.textContent='hapus';
        del.onclick=async()=>{try{await deleteDoc(doc(db,'gameComments',c.id))}catch(e){toast('Gagal hapus','err')}};
        nm.appendChild(del);
      }
      const tx=document.createElement('div');tx.className='cmt-text';tx.textContent=c.text||'';
      body.appendChild(nm);body.appendChild(tx);
      row.appendChild(av);row.appendChild(body);list.appendChild(row);
    });
  },e=>toast('Komentar: '+(e.code||e.message),'err'));
}
async function sendComment(){
  const t=$('#cmtInput').value.trim();if(!t||!cmtGid)return;
  if(!firebaseUser)return openLock(sendComment);
  $('#cmtInput').value='';
  try{await addDoc(collection(db,'gameComments'),{gameId:cmtGid,uid:firebaseUser.uid,name:userDoc?.name||'Anonim',av:userDoc?.av||'',text:t,ts:serverTimestamp()})}
  catch(e){toast('Gagal kirim komentar','err');$('#cmtInput').value=t}
}
 $('#cmtClose').onclick=()=>{$('#cmtModal').hidden=true;if(unsubCmt){unsubCmt();unsubCmt=null}};
