<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Zing — Arcade & TV</title>
<meta name="theme-color" content="#070b09">
<meta name="description" content="Zing — lobi game & TV. Main, bikin, bagikan.">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#070b09;--panel:rgba(13,28,18,.55);--line:rgba(47,232,107,.16);--line2:rgba(47,232,107,.35);--green:#2fe86b;--green-deep:#0c4f26;--ink:#eafff2;--mut:#7fa98d;--red:#ff5d5d;--amber:#ffc94d;--disp:'Bricolage Grotesque',sans-serif;--body:'Space Grotesk',sans-serif}
html,body{height:100%;background:var(--bg);color:var(--ink);font-family:var(--body);overflow:hidden}
body{background-image:radial-gradient(1100px 520px at 12% -8%,rgba(47,232,107,.09),transparent 60%),radial-gradient(900px 500px at 108% 108%,rgba(47,232,107,.07),transparent 60%),linear-gradient(rgba(47,232,107,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(47,232,107,.03) 1px,transparent 1px);background-size:auto,auto,44px 44px,44px 44px}
body.locked{overflow:hidden}
[hidden]{display:none!important}
::selection{background:var(--green);color:#04180b}
::-webkit-scrollbar{width:8px}::-webkit-scrollbar-thumb{background:var(--line2);border-radius:4px}
button{font-family:inherit;color:inherit}svg{display:block}
.screen{position:fixed;inset:0;z-index:1;overflow-y:auto;overflow-x:hidden}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes blink{0%,90%,100%{transform:scaleY(1)}94%{transform:scaleY(.1)}97%{transform:scaleY(1)}}
@keyframes dotPulse{0%,100%{box-shadow:0 0 0 0 rgba(47,232,107,.4)}50%{box-shadow:0 0 0 6px rgba(47,232,107,0)}}
@keyframes indet{0%{left:-40%}100%{left:105%}}
@keyframes wipePass{0%{transform:translateY(101%)}42%{transform:translateY(0)}58%{transform:translateY(0)}100%{transform:translateY(-101%)}}
@keyframes spinRing{to{transform:rotate(360deg)}}
#wipe{position:fixed;inset:0;z-index:200;background:var(--green);display:flex;align-items:center;justify-content:center;transform:translateY(101%);pointer-events:none}
#wipe span{font-family:var(--disp);font-weight:800;font-size:44px;color:#04180b;letter-spacing:-.02em}
#wipe.run{animation:wipePass .9s cubic-bezier(.7,0,.2,1) both}
.robot{overflow:visible}.robot .eyes{transform-origin:50px 50px;animation:blink 5s infinite}
.center-wrap{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20px;height:100%;text-align:center;padding:20px}
.wordmark{font-family:var(--disp);font-weight:800;font-size:46px;letter-spacing:-.03em;display:flex;align-items:baseline;gap:8px;line-height:1.15;padding-bottom:4px}
.wordmark>span:first-child{background:linear-gradient(120deg,#eafff2 30%,#8dffb8);-webkit-background-clip:text;background-clip:text;color:transparent;padding:0 .05em}
.wordmark .v2{font-size:14px;font-weight:700;color:#04180b;background:var(--green);border-radius:6px;padding:3px 8px;transform:translateY(-6px);box-shadow:0 0 22px rgba(47,232,107,.35)}
.tagline{font-size:11px;letter-spacing:.4em;color:var(--mut);text-transform:uppercase}
.bar{width:240px;height:5px;border-radius:4px;background:rgba(47,232,107,.1);overflow:hidden;position:relative}
.bar i{position:absolute;top:0;bottom:0;left:0;width:0%;background:var(--green)}
.bar.indet i{width:35%;animation:indet 1.1s infinite}
.splash-meta{display:flex;justify-content:space-between;width:240px;font-size:12px;color:var(--mut)}
.splash-meta b{color:var(--green)}
.splash-halo{position:relative;display:flex;align-items:center;justify-content:center}
.splash-halo::before{content:'';position:absolute;width:150px;height:150px;border-radius:50%;background:radial-gradient(circle,rgba(47,232,107,.22),transparent 70%);animation:dotPulse 2.4s infinite}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:600;font-size:14px;padding:12px 20px;border-radius:12px;border:1px solid transparent;cursor:pointer;transition:.15s}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-primary{background:var(--green);color:#04180b;box-shadow:0 4px 0 var(--green-deep)}
.btn-primary:hover{transform:translateY(-1px)}
.btn-ghost{background:rgba(47,232,107,.05);color:var(--ink);border-color:var(--line2)}
.btn-ghost:hover{background:rgba(47,232,107,.12)}
.btn-white{background:#fff;color:#14181c;border-color:#d8dee2}
.back-link{background:none;border:none;color:var(--mut);font-size:13px;cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.icon-btn{width:38px;height:38px;border-radius:10px;border:1px solid var(--line);background:rgba(7,17,11,.6);color:var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;flex:none;backdrop-filter:blur(6px)}
.icon-btn:hover{background:rgba(47,232,107,.12)}
.mode-cards{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin-top:6px}
.mode-card{width:210px;padding:24px;border-radius:18px;border:1px solid var(--line2);background:var(--panel);cursor:pointer;transition:.2s;color:var(--ink);display:flex;flex-direction:column;align-items:center;gap:8px;backdrop-filter:blur(8px)}
.mode-card:hover{border-color:var(--green);transform:translateY(-3px)}
.mode-card .mc-ico{color:var(--green);display:flex}
.mode-card b{font-family:var(--disp);font-size:17px}
.mode-card .mc-sub{font-size:12px;color:var(--mut)}
.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:14px 28px;background:rgba(7,11,9,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px}
.brand .wordmark{font-size:22px}
.brand .wordmark .v2{box-shadow:none}
.top-actions{display:flex;align-items:center;gap:10px}
.user-chip{display:flex;align-items:center;gap:10px;padding:5px 14px 5px 5px;border:1px solid var(--line);border-radius:99px;background:var(--panel);cursor:pointer}
.user-chip:hover{border-color:var(--line2)}
.avatar{width:32px;height:32px;border-radius:50%;background:var(--green);color:#04180b;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;overflow:hidden;flex:none}
.avatar img{width:100%;height:100%;object-fit:cover}
.user-chip span{font-size:14px;font-weight:600;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.home-main{width:min(1100px,92vw);margin:0 auto;padding:30px 0 90px}
.hello{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.hello h1{font-family:var(--disp);font-weight:800;font-size:clamp(26px,4vw,38px)}
.hello h1 em{font-style:normal;background:linear-gradient(120deg,#2fe86b,#a5ffc9);-webkit-background-clip:text;background-clip:text;color:transparent}
.hello p{color:var(--mut);margin-top:6px;font-size:14px}
.clock-chip{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:12px;padding:10px 16px;color:var(--mut);font-size:13px;background:var(--panel)}
.promo{margin:0 0 6px;padding:16px 20px;display:flex;align-items:center;gap:14px;justify-content:space-between;background:linear-gradient(120deg,rgba(47,232,107,.16),rgba(13,28,18,.4));border:1px solid var(--line2);border-radius:18px;flex-wrap:wrap;backdrop-filter:blur(8px)}
.promo h3{font-family:var(--disp);font-weight:800;font-size:18px}
.promo em{color:var(--green);font-style:normal}
.promo p{color:var(--mut);font-size:13px;margin-top:4px}
.promo .btn{flex:none}
.section-head{display:flex;align-items:center;gap:14px;margin:24px 0 14px}
.section-head h3{font-family:var(--disp);font-weight:800;font-size:18px}
.section-head i{flex:1;height:1px;background:var(--line)}
.section-head b{font-size:11px;color:var(--mut);letter-spacing:.15em}
.grid-games{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.gcard{position:relative;overflow:hidden;cursor:pointer;transition:.2s;display:flex;flex-direction:column;border-radius:20px;border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(8px)}
.gcard:hover{transform:translateY(-4px);border-color:var(--green);box-shadow:0 16px 34px rgba(0,0,0,.45)}
.gc-art{aspect-ratio:1/1;height:auto;border-bottom:1px solid var(--line);overflow:hidden;flex:none;background:#0a1610}
.gc-art img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s cubic-bezier(.2,.7,.2,1)}
.gcard:hover .gc-art img{transform:scale(1.06)}
.gi-letter{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-weight:800;font-size:56px;color:var(--green);opacity:.8}
.gc-info{padding:14px 18px;display:flex;flex-direction:column;gap:5px;flex:1;min-width:0}
.gc-info h4{font-family:var(--disp);font-weight:800;font-size:19px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.gc-info p{color:var(--mut);font-size:12.5px;line-height:1.45}
.gc-meta{display:flex;align-items:center;gap:6px;margin-top:auto;font-size:11px;color:#5f8a72;padding-top:4px}
.gc-tag{align-self:flex-start;font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--green);border:1px solid var(--line2);border-radius:99px;padding:3px 10px}
.gcard.upload{border-style:dashed;background:transparent;min-height:230px;align-items:center;justify-content:center;text-align:center;padding:20px;color:var(--mut);gap:10px}
.gcard.upload:hover{color:var(--green);border-color:var(--green)}
.gcard.upload h4{font-family:var(--disp);font-weight:800;font-size:17px}
.gcard.upload p{font-size:12px}
.up-plus{width:48px;height:48px;border-radius:50%;border:2px dashed var(--line2);display:flex;align-items:center;justify-content:center;color:var(--green)}
.gc-del{position:absolute;top:10px;right:10px;z-index:4;width:32px;height:32px;border-radius:9px;border:1px solid var(--line2);background:rgba(7,17,11,.88);color:var(--mut);cursor:pointer;display:flex;align-items:center;justify-content:center}
.gc-del:hover{color:var(--red);border-color:var(--red)}
.gc-edit{right:50px}.gc-edit:hover{color:var(--green);border-color:var(--green)}
.gc-actions{display:flex;align-items:center;gap:6px;margin-top:10px;flex-wrap:wrap}
.gc-act{display:inline-flex;align-items:center;gap:6px;background:none;border:1px solid var(--line);border-radius:99px;padding:7px 12px;font-size:12px;font-weight:600;color:var(--mut);cursor:pointer;transition:.15s}
.gc-act:hover{border-color:var(--green);color:var(--green)}
.gc-act.liked{color:var(--red);border-color:rgba(255,93,93,.45)}
.gc-act svg{flex:none}
.gc-act .n{font-weight:700}
.home-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 28px;border-top:1px solid var(--line);color:#5f8a72;font-size:12px;flex-wrap:wrap}
.sys{display:flex;align-items:center;gap:8px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green);animation:dotPulse 1.8s infinite;flex:none}
.modal{position:fixed;inset:0;z-index:120;background:rgba(4,10,6,.8);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:20px}
.modal-panel{width:min(480px,100%);background:#0a1410;border:1px solid var(--line2);border-radius:20px;padding:26px;animation:fadeUp .3s;max-height:88vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.5)}
.modal-panel h3{font-family:var(--disp);font-weight:800;font-size:21px;margin-bottom:4px;text-align:center}
.msub{color:var(--mut);font-size:14px;margin-bottom:18px;text-align:center}
.form-grid{display:flex;flex-direction:column;gap:13px}
.f-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);margin-bottom:6px;display:block}
.f-input,.f-area,.f-select{width:100%;background:#04110a;border:1px solid var(--line);border-radius:12px;padding:12px 14px;color:var(--ink);font-size:14px;outline:none}
.f-input:focus,.f-area:focus,.f-select:focus{border-color:var(--green)}
.f-area{min-height:100px;font-family:ui-monospace,monospace;font-size:12px;resize:vertical}
.seg{display:flex;gap:8px}
.seg-btn{flex:1;padding:10px;border-radius:10px;border:1px solid var(--line);background:#04110a;color:var(--mut);font-size:13px;cursor:pointer}
.seg-btn.active{border-color:var(--green);color:var(--green);background:rgba(47,232,107,.08)}
.icon-pick{display:flex;gap:12px;align-items:center}
.icon-prev{width:60px;height:60px;border-radius:14px;border:1px solid var(--line2);background:#04110a;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:22px;color:var(--green);overflow:hidden;flex:none}
.icon-prev img{width:100%;height:100%;object-fit:cover}
.cmt-item{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line)}
.cmt-item:last-child{border-bottom:none}
.cmt-av{width:30px;height:30px;border-radius:50%;background:#1d3a26;color:var(--green);font-weight:700;display:flex;align-items:center;justify-content:center;font-size:12px;overflow:hidden;flex:none}
.cmt-av img{width:100%;height:100%;object-fit:cover}
.cmt-body{flex:1;min-width:0}
.cmt-name{font-size:11px;color:var(--mut);font-weight:600;display:flex;justify-content:space-between;gap:8px}
.cmt-del{background:none;border:none;color:var(--mut);font-size:11px;cursor:pointer}
.cmt-del:hover{color:var(--red)}
.cmt-text{font-size:13.5px;line-height:1.5;word-break:break-word;margin-top:2px}
.cmt-input-row{display:flex;gap:8px;margin-top:14px}
.cmt-input-row input{flex:1;background:#04110a;border:1px solid var(--line);border-radius:12px;padding:10px 14px;color:var(--ink);font-size:13.5px;outline:none}
.cmt-input-row input:focus{border-color:var(--green)}
#player{position:fixed;inset:0;z-index:100;background:#000;display:flex;flex-direction:column}
.p-head{display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--line);background:rgba(5,13,8,.95)}
.p-title{font-family:var(--disp);font-weight:800;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.p-right{margin-left:auto;display:flex;gap:8px}
.sess-chip{border:1px solid var(--line);border-radius:10px;padding:7px 12px;font-size:13px;color:var(--mut)}
.p-body{position:relative;flex:1;overflow:hidden}
#gameFrame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#000}
#zingLoader{position:absolute;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:5}
#frameError{position:absolute;inset:0;background:rgba(6,13,8,.96);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:24px}
#player.zen .p-head{display:none}
.zen-btns{position:absolute;top:10px;right:10px;z-index:8;display:none;gap:8px}
#player.zen .zen-btns{display:flex}
.chat-fab{position:fixed;bottom:24px;right:24px;z-index:90;width:54px;height:54px;border-radius:50%;background:var(--green);color:#04180b;border:none;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.5);cursor:pointer}
#chatBadge{position:absolute;top:-4px;right:-4px;min-width:20px;height:20px;padding:0 5px;border-radius:99px;background:var(--amber);color:#231a02;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;border:2px solid var(--bg)}
.chat-full-head,.ai-hero{display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--line);background:rgba(7,11,9,.9);backdrop-filter:blur(10px)}
.cf-info,.ah-info{flex:1;min-width:0}
.chat-full-head h3,.ai-hero h3{font-family:var(--disp);font-weight:800;font-size:18px;display:flex;align-items:center;gap:10px}
.cf-sub,.ah-sub{font-size:12px;color:var(--mut);margin-top:2px}
.ai-badge{font-size:9px;font-weight:800;letter-spacing:.12em;background:rgba(47,232,107,.12);color:var(--green);border:1px solid var(--line2);padding:2px 8px;border-radius:6px;cursor:pointer}
.ai-badge:hover{background:rgba(47,232,107,.22)}
.ai-tabs{display:flex;gap:8px;padding:16px 24px 0;width:min(800px,100%);margin:0 auto}
.ai-tab{display:flex;align-items:center;justify-content:center;gap:8px;padding:10px 14px;border-radius:12px;font-weight:600;font-size:13px;color:var(--mut);cursor:pointer;border:1px solid var(--line);background:rgba(13,28,18,.4)}
.ai-tab.active{color:var(--green);background:rgba(47,232,107,.1);border-color:var(--line2)}
.chat-full-body,.ai-body{flex:1;overflow-y:auto;padding:22px;display:flex;flex-direction:column;gap:16px;width:min(800px,100%);margin:0 auto}
.chat-msg,.ai-msg{display:flex;flex-direction:column;gap:6px;max-width:85%}
.chat-msg.me,.ai-msg.user{align-self:flex-end;align-items:flex-end}
.chat-msg .cm-av{width:32px;height:32px;border-radius:50%;background:#1d3a26;color:var(--green);font-weight:700;display:flex;align-items:center;justify-content:center;overflow:hidden;flex:none}
.chat-msg .cm-av img{width:100%;height:100%;object-fit:cover}
.cm-name,.ai-role{font-size:11px;color:var(--mut);font-weight:600}
.cm-bubble,.ai-content{padding:12px 16px;border-radius:16px;font-size:14px;line-height:1.55;white-space:pre-wrap;word-break:break-word}
.chat-msg.me .cm-bubble,.ai-msg.user .ai-content{background:var(--green);color:#04180b;border-bottom-right-radius:4px}
.chat-msg .cm-bubble,.ai-msg.bot .ai-content{background:var(--panel);border:1px solid var(--line);border-bottom-left-radius:4px}
.ai-msg .ai-content{width:fit-content;max-width:100%}
.ai-loader{display:flex;align-items:center;gap:10px;color:var(--mut);font-size:13px;padding:12px 16px;background:var(--panel);border:1px solid var(--line);border-radius:16px;align-self:flex-start;width:fit-content}
.ai-input-bar,.chat-full-foot{padding:14px 24px 18px;border-top:1px solid var(--line);background:rgba(7,11,9,.95)}
.ai-input-bar .inner,.chat-input{display:flex;gap:10px;align-items:center;width:min(800px,100%);margin:0 auto}
.ai-input-bar textarea,.chat-full-foot input{flex:1;background:#04110a;border:1px solid var(--line);border-radius:14px;padding:12px 16px;color:var(--ink);font-size:14px;outline:none;resize:none}
.ai-input-bar textarea:focus,.chat-full-foot input:focus{border-color:var(--green)}
.ai-send-btn,.btn-send{width:44px;height:44px;border-radius:12px;background:var(--green);color:#04180b;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex:none}
.ai-code{background:#04110a;border:1px solid var(--line);border-radius:12px;margin-top:8px;overflow:hidden;width:100%}
.ai-code-bar{display:flex;justify-content:flex-end;gap:6px;padding:8px;background:rgba(47,232,107,.05);border-bottom:1px solid var(--line);flex-wrap:wrap}
.ai-code-bar button{background:rgba(47,232,107,.1);border:1px solid var(--line2);color:var(--green);padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer}
.ai-code pre{padding:12px;font-family:ui-monospace,monospace;font-size:12px;color:#a5ffc9;overflow:auto;max-height:320px;white-space:pre;margin:0}
.ai-img-result{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
.ai-img-result img{max-width:min(320px,100%);border-radius:14px;border:1px solid var(--line2)}
.ai-img-row{display:flex;gap:8px;flex-wrap:wrap}
.bottom-nav{display:none;position:fixed;bottom:0;left:0;right:0;z-index:90;background:rgba(7,11,9,.96);backdrop-filter:blur(14px);border-top:1px solid var(--line);justify-content:space-around;align-items:stretch;padding-bottom:env(safe-area-inset-bottom)}
.bottom-nav button{background:none;border:none;color:var(--mut);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:10px;font-weight:600;padding:9px 14px;position:relative;min-width:64px}
.bottom-nav button.active{color:var(--green)}
.bottom-nav button.active::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:26px;height:3px;border-radius:2px;background:var(--green);box-shadow:0 0 10px rgba(47,232,107,.6)}
#toasts{position:fixed;bottom:26px;left:50%;transform:translateX(-50%);z-index:300;display:flex;flex-direction:column;gap:10px;align-items:center;pointer-events:none}
.toast{display:flex;align-items:center;gap:10px;background:#0f2416;border:1px solid var(--line2);padding:12px 18px;border-radius:12px;font-size:14px;max-width:min(440px,88vw)}
.toast.err{border-color:#5c2323;background:#241010}
.toast.ok svg{color:var(--green)}.toast.err svg{color:var(--red)}
/* ===== MODE HP ===== */
body[data-mode="hp"] .top{padding:10px 14px}
body[data-mode="hp"] .brand .wordmark{font-size:18px}
body[data-mode="hp"] .home-main{width:100%;max-width:640px;padding:14px 12px calc(100px + env(safe-area-inset-bottom))}
body[data-mode="hp"] .hello{margin-bottom:12px;gap:10px}
body[data-mode="hp"] .hello h1{font-size:21px}
body[data-mode="hp"] .hello p{font-size:12px}
body[data-mode="hp"] .clock-chip{display:none}
body[data-mode="hp"] .promo{padding:14px 16px;border-radius:16px}
body[data-mode="hp"] .promo h3{font-size:15px}
body[data-mode="hp"] .promo p{font-size:11.5px}
body[data-mode="hp"] .promo .btn{padding:10px 14px;font-size:12.5px}
body[data-mode="hp"] .section-head{margin:16px 0 10px}
body[data-mode="hp"] .section-head h3{font-size:16px}
body[data-mode="hp"] .grid-games{grid-template-columns:repeat(2,1fr);gap:12px}
body[data-mode="hp"] .gcard{border-radius:16px}
body[data-mode="hp"] .gc-art{aspect-ratio:1/1}
body[data-mode="hp"] .gc-info{padding:10px 10px 8px;gap:4px;align-items:center}
body[data-mode="hp"] .gc-info h4{font-size:14px;text-align:center;width:100%}
body[data-mode="hp"] .gc-info p,body[data-mode="hp"] .gc-tag,body[data-mode="hp"] .gc-meta{display:none}
body[data-mode="hp"] .gc-actions{margin-top:2px;padding:0 2px 6px;justify-content:center;gap:6px;flex-wrap:nowrap}
body[data-mode="hp"] .gc-act{padding:8px 12px;font-size:0;gap:0;border-radius:12px}
body[data-mode="hp"] .gc-act svg{width:16px;height:16px;margin:0}
body[data-mode="hp"] .gc-act .n{display:none}
body[data-mode="hp"] .gcard.upload{min-height:0;aspect-ratio:1/1;padding:10px;gap:8px}
body[data-mode="hp"] .gcard.upload h4{font-size:13px}
body[data-mode="hp"] .gcard.upload p{display:none}
body[data-mode="hp"] .up-plus{width:40px;height:40px}
body[data-mode="hp"] .gc-del{top:8px;right:8px}
body[data-mode="hp"] .gc-edit{right:48px}
body[data-mode="hp"] .home-foot,body[data-mode="hp"] .chat-fab{display:none}
body[data-mode="hp"][data-screen="screen-home"] .bottom-nav,
body[data-mode="hp"][data-screen="screen-chat"] .bottom-nav,
body[data-mode="hp"][data-screen="screen-ai"] .bottom-nav{display:flex}
body.playing .bottom-nav{display:none!important}
body[data-mode="hp"] #screen-chat,body[data-mode="hp"] #screen-ai{padding-bottom:calc(64px + env(safe-area-inset-bottom))}
body[data-mode="hp"] .chat-full-body,body[data-mode="hp"] .ai-body{padding:14px 12px}
body[data-mode="hp"] .chat-full-foot,body[data-mode="hp"] .ai-input-bar{padding:10px 12px}
body[data-mode="hp"] .ai-tabs{padding:10px 12px 0}
body[data-mode="hp"] .ai-tab{flex:1;padding:11px 6px;font-size:12px}
body[data-mode="hp"] .chat-msg,body[data-mode="hp"] .ai-msg{max-width:100%}
body[data-mode="hp"] .modal{padding:0;align-items:flex-end}
body[data-mode="hp"] .modal-panel{width:100%;border-radius:18px 18px 0 0;max-height:86vh;padding:18px 16px calc(18px + env(safe-area-inset-bottom))}
