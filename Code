/* ===== ZING AI — Pollinations, timeout keras: tidak ada "thinking" abadi ===== */
const AI_SYS={
  image:'Kamu Zing AI di portal game Zing. Bahasa Indonesia santai. Bantu pengguna menyusun prompt gambar yang deskriptif dan bagus.',
  code:'Kamu adalah Zing AI, pembuat game di portal Zing. Buat SATU file HTML game lengkap dan siap main. WAJIB: tag <title> berisi nama game; tampilan cantik bertema gelap-hijau; kontrol keyboard (panah/WASD/spasi) DAN tombol sentuh on-screen agar bisa dimainkan di HP; ada skor dan tombol Mulai Ulang; tanpa placeholder, tanpa API berbayar. Jawab dalam bahasa Indonesia: satu blok kode ```html ...``` lalu maksimal 2 kalimat penjelasan.',
  agent:'Kamu adalah Zing AI Agent, ahli perbaikan game HTML. Perbaiki kode pengguna: bug, tampilan, performa HP & PC, fitur yang diminta. WAJIB kembalikan file final lengkap dan siap main dalam satu blok ```html ...``` (jangan potong-potong). Sebelum kode, tulis maksimal 3 poin perubahan dengan tanda "-".'
};
function fetchTO(url,opts,ms){
  const c=new AbortController();
  const t=setTimeout(()=>c.abort(),ms);
  return fetch(url,opts?{...opts,signal:c.signal}:{signal:c.signal}).finally(()=>clearTimeout(t));
}
async function aiText(sys,prompt){
  /* Jalur 1: GET (cepat & stabil untuk prompt pendek) */
  if(prompt.length<1400){
    try{
      const url='https://text.pollinations.ai/'+encodeURIComponent(prompt)+'?model=openai&system='+encodeURIComponent(sys);
      const r=await fetchTO(url,null,45000);
      if(r.ok){const c=await r.text();if(c&&c.trim().length>3)return c;}
    }catch(e){}
  }
  /* Jalur 2: POST (untuk prompt panjang / cadangan) */
  const r=await fetchTO('https://text.pollinations.ai/openai',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({model:'openai',messages:[{role:'system',content:sys},{role:'user',content:prompt}]})
  },60000);
  if(!r.ok)throw new Error('HTTP '+r.status+' — server AI sibuk, coba lagi 1 menit');
  const j=await r.json().catch(()=>null);
  const c=j?.choices?.[0]?.message?.content;
  if(!c||c.trim().length<10)throw new Error('Respons kosong, coba lagi');
  return c;
}
async function callAI(messages){
  const sys=AI_SYS[aiTab];
  const last=messages[messages.length-1]?.content||'halo';
  const hist=messages.slice(0,-1).filter(m=>m.role==='user').slice(-2).map(m=>'- '+m.content).join('\n');
  return await aiText(sys,(hist?hist+'\n\nPermintaan:\n':'')+last);
}
function callImgUrl(prompt){
  return 'https://image.pollinations.ai/prompt/'+encodeURIComponent(prompt)+'?width=768&height=768&nologo=true&enhance=true&seed='+Math.floor(Math.random()*1e6);
}
async function callImg(prompt){
  const u=callImgUrl(prompt);
  await new Promise((res,rej)=>{
    const i=new Image();
    const t=setTimeout(()=>rej(new Error('Timeout 60 detik — coba lagi')),60000);
    i.onload=()=>{clearTimeout(t);res()};
    i.onerror=()=>{clearTimeout(t);rej(new Error('Gagal membuat gambar, coba prompt lain'))};
    i.src=u;
  });
  return u;
}
