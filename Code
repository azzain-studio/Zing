async function sendAI(){
  const inp=$('#aiInput');const t=inp.value.trim();
  if(!t||aiBusy)return;if(!firebaseUser)return openLock(sendAI);
  aiBusy=true;$('#aiSend').disabled=true;inp.value='';inp.style.height='auto';
  aiHist.push({role:'user',text:t,src:t});renderAI();
  const guard=setTimeout(()=>{
    if(aiBusy){aiBusy=false;$('#aiSend').disabled=false;toast('Terlalu lama, kirim ulang ya','err');renderAI()}
  },120000);
  try{
    let out;
    if(aiTab==='image')out='@@IMG:'+await callImg(t);
    else out=await callAI([{role:'system',content:AI_SYS[aiTab]},...aiHist.filter(m=>m.text&&!m.text.startsWith('@@IMG')).slice(-8).map(m=>({role:m.role,content:m.text}))]);
    aiHist.push({role:'assistant',text:out,src:t});
  }catch(e){
    toast('Zing AI: '+e.message,'err');
    aiHist.push({role:'assistant',text:e.message,src:t});
  }
  clearTimeout(guard);
  saveHist();
  aiBusy=false;$('#aiSend').disabled=false;renderAI();
}
