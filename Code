let pTimer=null,lastSrc='',watchdog=null;
function launchPlayer(title,url){
  $('#pTitle').textContent=title;
  $('#player').classList.remove('zen');
  $('#player').hidden=false;$('#frameError').hidden=true;$('#zingLoader').style.display='flex';
  document.body.classList.add('playing');
  const f=$('#gameFrame');f.hidden=true;f.src='about:blank';
  let sec=0;clearInterval(pTimer);pTimer=setInterval(()=>{sec++;$('#sessTime').textContent=String(Math.floor(sec/60)).padStart(2,'0')+':'+String(sec%60).padStart(2,'0')},1000);
  let loaded=false;
  f.onload=()=>{if(f.src==='about:blank')return;loaded=true;$('#zingLoader').style.display='none';f.hidden=false};
  lastSrc=url;f.src=url;
  clearTimeout(watchdog);
  watchdog=setTimeout(()=>{if(!loaded){$('#zingLoader').style.display='none';$('#frameError').hidden=false}},10000);
}
function exitPlayer(){clearInterval(pTimer);clearTimeout(watchdog);$('#gameFrame').src='about:blank';$('#player').hidden=true;$('#player').classList.remove('zen');document.body.classList.remove('playing');enterHome()}
function openGame(id){
  if(!firebaseUser)return openLock(()=>openGame(id));
  if(BUILTIN_DEFAULTS[id]){
    const d=builtinOf(id);
    if(!d.url)return toast('URL game belum diatur','err');
    launchPlayer(d.title,d.url);
    updateDoc(doc(db,'stats','plays'),{[id]:increment(1)}).catch(()=>{});
  }else{
    const gm=cloudGames.find(g=>g.id===id);if(!gm)return toast('Game tidak ditemukan','err');
    if(gm.type==='code'&&gm.code)launchPlayer(gm.name,URL.createObjectURL(new Blob([gm.code],{type:'text/html'})));
    else{if(!gm.link)return toast('Game belum punya link','err');launchPlayer(gm.name,gm.link)}
    updateDoc(doc(db,'games',gm.id),{plays:increment(1)}).catch(()=>{});
  }
}
